# Keep real values in ignored .env.local or hosted runtime secrets.
# Never paste these values into a browser form or a public repository.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Leave false until the account owner explicitly approves AI API usage.
STEWARD_ENABLE_AI=false
# Select compatible or openai explicitly; there is no provider fallback.
STEWARD_AI_PROVIDER=compatible
STEWARD_AI_BASE_URL=https://provider.example/v1
STEWARD_AI_API_KEY=
STEWARD_AI_MODEL=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# Sign in and copy your own Site user ID from the Setup screen.
STEWARD_OWNER_ID=
