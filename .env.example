# Copy to .env.local (git-ignored) or set as runtime secrets.

# Circle Developer-Controlled Wallets, Arc testnet only
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_BLOCKCHAIN=ARC-TESTNET

# User ID allowed to send payments and change policy (shown on the Setup screen)
STEWARD_OWNER_ID=

# Optional LLM review, off by default
STEWARD_ENABLE_AI=false
# compatible or openai; there is no fallback between them
STEWARD_AI_PROVIDER=compatible
STEWARD_AI_BASE_URL=https://api.example.com/v1
STEWARD_AI_API_KEY=
STEWARD_AI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
